---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const currentYear = new Date().getFullYear();
---

<ol class="project-list">
  {projects.map((project) => {
    const { title, description, publishedAt, tags, github, demo } = project.data;
    return (
      <li class="project-row">
        <time datetime={publishedAt.toISOString()} class:list={{ 'is-current-year': publishedAt.getFullYear() === currentYear }}>{publishedAt.getFullYear()}</time>
        <div class="project-main">
          <h3 class="project-title">{title}</h3>
          <p class="project-description">{description}</p>
          <ul class="tag-list">
            {tags.map((tag: string) => <li>{tag}</li>)}
          </ul>
        </div>
        {(github || demo) && (
          <ul class="project-links">
            {demo && (
              <li><a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">사이트</a></li>
            )}
            {github && (
              <li><a class="text-link" href={github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            )}
          </ul>
        )}
      </li>
    );
  })}
</ol>

<style>
  .project-list {
    list-style: none;
  }

  .project-row {
    display: grid;
    grid-template-columns: var(--col-meta) minmax(0, 1fr) auto;
    gap: var(--spacing-md);
    padding-block: var(--spacing-md);
  }

  .project-row + .project-row {
    border-top: 1px solid var(--color-border);
  }

  time {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  /* This year's work is marked in the accent so recent activity reads at a glance */
  .is-current-year {
    color: var(--color-accent);
    font-weight: 500;
  }

  .project-title {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-2xs);
  }

  .project-description {
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-xs);
    max-width: 38rem;
  }

  .project-links {
    display: flex;
    gap: var(--spacing-sm);
    list-style: none;
    font-size: var(--text-sm);
    padding-top: 0.2rem;
  }

  @media (max-width: 640px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xs);
    }

    .project-links {
      padding-top: var(--spacing-xs);
    }
  }
</style>
