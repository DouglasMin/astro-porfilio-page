---
const navLinks = [
  { name: '홈', href: '/' },
  { name: '프로젝트', href: '/projects' },
  { name: '블로그', href: '/blog' },
  { name: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header class="header">
  <nav class="nav container" aria-label="주요 메뉴">
    <a href="/" class="logo">douglas<span class="logo-dot">.</span>min</a>

    <ul class="nav-links">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <button id="theme-toggle" class="theme-toggle pressable" aria-label="다크 모드 전환">
      <svg class="theme-icon sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <svg class="theme-icon moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    height: 3.5rem;
  }

  .logo {
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .logo:hover {
    color: var(--color-text);
  }

  .logo-dot {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: var(--spacing-md);
    list-style: none;
    margin-left: auto;
    font-size: var(--text-sm);
  }

  .nav-link {
    color: var(--color-text-secondary);
    padding-block: 0.25rem;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link.active {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-right: -0.5rem;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background-color: var(--color-accent-soft);
  }

  /* Both icons share one cell and crossfade so the state change reads as one object turning */
  .theme-icon {
    grid-area: 1 / 1;
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }

  .sun-icon,
  :global([data-theme="dark"]) .moon-icon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  :global([data-theme="dark"]) .sun-icon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sun-icon,
    :global([data-theme="dark"]) .moon-icon {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .nav {
      gap: var(--spacing-sm);
    }

    .nav-links {
      gap: var(--spacing-sm);
    }
  }
</style>

<script>
  function setupThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    const savedTheme = localStorage.getItem('theme') || 'light';
    html.dataset.theme = savedTheme;

    themeToggle?.addEventListener('click', () => {
      const currentTheme = html.dataset.theme;
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';

      html.dataset.theme = newTheme;
      localStorage.setItem('theme', newTheme);
    });
  }

  // 첫 로드 + View Transitions 페이지 전환 시 (astro:page-load는 첫 로드에도 발생)
  document.addEventListener('astro:page-load', () => {
    setupThemeToggle();
  });

  // 테마 복원
  document.addEventListener('astro:after-swap', () => {
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.dataset.theme = savedTheme;
  });
</script>
