---
import type { CollectionEntry } from 'astro:content';

export interface ExperienceItem {
  id: string;
  data: CollectionEntry<'experience'>['data'];
  htmlContent: string;
}

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<ol class="experience-list">
  {items.map((item) => (
    <li class="experience-row">
      <p class="period">{item.data.period}</p>
      <div class="experience-main">
        <h3>{item.data.title}</h3>
        <p class="organization">
          {item.data.company}
          {item.data.role && <span class="role">{item.data.role}</span>}
        </p>
        <div class="experience-body" set:html={item.htmlContent} />
      </div>
    </li>
  ))}
</ol>

<style>
  .experience-list {
    list-style: none;
  }

  .experience-row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--spacing-md);
    padding-block: var(--spacing-lg);
  }

  .experience-row + .experience-row {
    border-top: 1px solid var(--color-border);
  }

  .period {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  .experience-main h3 {
    font-size: var(--text-lg);
  }

  .organization {
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-sm);
  }

  .role {
    color: var(--color-muted);
    margin-left: var(--spacing-xs);
  }

  .experience-body {
    max-width: 38rem;
    font-size: var(--text-sm);
  }

  .experience-body :global(h2),
  .experience-body :global(h3) {
    font-size: var(--text-base);
    font-weight: 500;
    margin-top: var(--spacing-sm);
  }

  .experience-body :global(p),
  .experience-body :global(li) {
    color: var(--color-text-secondary);
  }

  .experience-body :global(ul) {
    padding-left: 1.2em;
    margin-top: var(--spacing-2xs);
  }

  .experience-body :global(li::marker) {
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .experience-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xs);
    }
  }
</style>
