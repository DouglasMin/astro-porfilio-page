---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="방문 분석 - 관리자" description="사이트 방문 통계" noindex>
  <div class="container admin-page">
    <header class="page-intro">
      <h1>방문 분석</h1>
      <p>누가, 어디서, 어떤 기기로 들어와 무엇을 읽었는지 확인합니다.</p>
    </header>

    <p id="admin-message" class="admin-message" role="status" hidden></p>

    <section id="admin-login" class="login-card" aria-labelledby="login-title">
      <h2 id="login-title">관리자 토큰으로 들어가기</h2>
      <form id="login-form">
        <label for="admin-token">관리자 토큰</label>
        <input id="admin-token" name="token" type="password" autocomplete="current-password" required spellcheck="false" />
        <label class="checkbox">
          <input type="checkbox" name="exclude" checked />
          이 브라우저의 방문은 통계에서 제외
        </label>
        <button type="submit" class="admin-button admin-button-primary pressable">들어가기</button>
      </form>
    </section>

    <section id="admin-dashboard" hidden aria-label="방문 통계">
      <div class="toolbar">
        <div class="range-presets" role="group" aria-label="기간">
          <button type="button" class="admin-button pressable" data-range="1">오늘</button>
          <button type="button" class="admin-button pressable" data-range="7">7일</button>
          <button type="button" class="admin-button pressable" data-range="30">30일</button>
          <button type="button" class="admin-button pressable" data-range="90">90일</button>
        </div>
        <div class="range-custom">
          <label class="visually-hidden" for="range-from">시작일</label>
          <input id="range-from" type="date" />
          <span aria-hidden="true">~</span>
          <label class="visually-hidden" for="range-to">종료일</label>
          <input id="range-to" type="date" />
        </div>
        <div class="toolbar-actions">
          <button type="button" id="refresh-btn" class="admin-button pressable">새로고침</button>
          <button type="button" id="logout-btn" class="admin-button pressable">로그아웃</button>
        </div>
      </div>
      <div id="dashboard-output" class="dashboard-output"></div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initAdminDashboard } from '../scripts/admin-dashboard';

  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname.startsWith('/admin')) initAdminDashboard();
  });
</script>

<!-- Dashboard nodes are created in the browser, so these styles cannot be component-scoped -->
<style is:global>
  .admin-page {
    --chart-primary: #2a45c9;
    --chart-context: #8a909c;
  }

  [data-theme="dark"] .admin-page {
    --chart-primary: #7188f5;
    --chart-context: #737b88;
  }

  .admin-message {
    padding: 0.75rem 1rem;
    margin-bottom: var(--spacing-md);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .login-card {
    max-width: 24rem;
    padding: var(--spacing-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .login-card h2 {
    margin-bottom: var(--spacing-md);
  }

  .login-card form {
    display: grid;
    gap: var(--spacing-xs);
  }

  .login-card label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .admin-page input[type="password"],
  .admin-page input[type="date"] {
    font: inherit;
    font-size: var(--text-sm);
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .login-card .checkbox {
    display: flex;
    gap: var(--spacing-xs);
    align-items: center;
    margin-block: var(--spacing-xs);
  }

  .admin-button {
    font: inherit;
    font-size: var(--text-sm);
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .admin-button:hover {
    color: var(--color-text);
    border-color: var(--color-text-secondary);
  }

  .admin-button[aria-pressed="true"] {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .admin-button-primary {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .admin-button-primary:hover {
    color: var(--color-on-accent);
    background: var(--color-accent-hover);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm);
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .range-presets,
  .range-custom,
  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xs);
  }

  .toolbar-actions {
    margin-left: auto;
  }

  .dashboard-output {
    display: grid;
    gap: var(--spacing-xl);
    transition: opacity var(--duration-base) ease;
  }

  .dashboard-output[aria-busy="true"] {
    opacity: 0.5;
  }

  .live-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs) var(--spacing-sm);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .live-counters {
    color: var(--color-muted);
    margin-left: auto;
  }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    border-top: 2px solid var(--color-accent);
  }

  .kpi {
    padding: var(--spacing-md) var(--spacing-sm) var(--spacing-sm) 0;
  }

  .kpi-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .kpi-value {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .kpi-detail {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--spacing-xl) var(--spacing-lg);
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding-top: var(--spacing-xs);
    border-top: 1px solid var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .panel-head h2 {
    font-size: var(--text-base);
  }

  .panel-note {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-align: right;
  }

  .empty-state {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Bar lists */
  .bar-list {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--text-sm);
  }

  .bar-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text);
  }

  a.bar-label {
    color: var(--color-accent);
  }

  .bar-track {
    height: 0.5rem;
  }

  .bar-fill {
    display: block;
    height: 100%;
    border-radius: 0 4px 4px 0;
    background: var(--chart-primary);
  }

  .bar-value {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    text-align: right;
  }

  /* Tables */
  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .data-table th,
  .data-table td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .data-table th {
    font-weight: 500;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .data-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .page-cell {
    display: grid;
  }

  .page-title {
    color: var(--color-text);
  }

  .page-path {
    font-size: var(--text-xs);
    color: var(--color-muted);
    word-break: break-all;
  }

  .table-toggle {
    margin-top: var(--spacing-sm);
    font-size: var(--text-sm);
  }

  .table-toggle summary {
    cursor: pointer;
    color: var(--color-text-secondary);
  }

  /* Charts */
  .chart,
  .heatmap {
    position: relative;
  }

  .chart svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .chart-legend {
    display: flex;
    gap: var(--spacing-md);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xs);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-swatch {
    width: 0.9rem;
    height: 2px;
    border-radius: 1px;
  }

  .swatch-primary {
    background: var(--chart-primary);
  }

  .swatch-context {
    background: var(--chart-context);
  }

  .chart-grid {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .chart-axis {
    fill: var(--color-muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .chart-line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .chart-line-primary {
    stroke: var(--chart-primary);
  }

  .chart-line-context {
    stroke: var(--chart-context);
  }

  .chart-crosshair {
    stroke: var(--color-text-secondary);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .chart-dot {
    stroke: var(--color-bg);
    stroke-width: 2;
  }

  .chart-dot-primary {
    fill: var(--chart-primary);
  }

  .chart-dot-context {
    fill: var(--chart-context);
  }

  .chart-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    min-width: 8rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
    font-size: var(--text-xs);
    pointer-events: none;
    z-index: 2;
  }

  .chart-tooltip-title {
    color: var(--color-text);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .chart-tooltip-row {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-sm);
    color: var(--color-text-secondary);
  }

  .chart-tooltip-row strong {
    color: var(--color-text);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Heatmap */
  .heatmap-grid {
    display: grid;
    grid-template-columns: 1.5rem repeat(24, minmax(0, 1fr));
    gap: 2px;
    font-size: 11px;
    color: var(--color-muted);
  }

  .heatmap-hour {
    text-align: left;
  }

  .heatmap-day {
    align-self: center;
  }

  .heatmap-cell {
    aspect-ratio: 1;
    min-height: 0.75rem;
    border-radius: 2px;
    background: color-mix(in oklab, var(--chart-primary) var(--strength, 0%), var(--color-surface));
    outline: 1px solid color-mix(in oklab, var(--color-border) 60%, transparent);
    outline-offset: -1px;
  }

  .generated-at {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .toolbar-actions {
      margin-left: 0;
    }

    .bar-row {
      grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) auto;
    }
  }
</style>
