---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, getPostData, readingMinutes, type BlogEntry } from '../../lib/blog';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry: BlogEntry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: BlogEntry };
const { title, description, publishedAt, tags } = getPostData(entry);
const minutes = readingMinutes(entry);

// Render the Notion content via the loader's built-in rendering
const { Content } = await render(entry);
---

<BaseLayout title={`${title} - 민동익 (Douglas)`} description={description}>
  <div class="progress-bar" id="progress-bar" aria-hidden="true"></div>

  <article class="container post">
    <header class="post-header">
      <a href="/blog" class="back-link text-link">목록으로</a>
      <p class="post-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        <span>{minutes}분 분량</span>
      </p>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-lead">{description}</p>}
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag: string) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    <div class="post-layout">
      <div class="prose">
        <Content />
      </div>

      <aside class="toc-sidebar" id="toc-sidebar" aria-labelledby="toc-title">
        <div class="toc-sticky">
          <h2 id="toc-title" class="toc-title">이 글의 목차</h2>
          <nav class="toc" id="toc"></nav>
        </div>
      </aside>
    </div>

    <footer class="post-footer">
      <div class="author">
        <p class="author-name">민동익 Dongik Min</p>
        <p>AI 에이전트와 서버리스로 제품을 만드는 풀스택 개발자/DevOps입니다.</p>
      </div>
      <div class="post-actions">
        <button type="button" class="action-button pressable" id="copy-link-btn"><span>링크 복사</span></button>
        <a href="/blog" class="back-link text-link">목록으로</a>
      </div>
    </footer>
  </article>

  <dialog class="image-viewer" id="image-viewer" aria-label="이미지 크게 보기">
    <div class="viewer-stage">
      <img class="viewer-image" alt="" draggable="false" />
    </div>
    <div class="viewer-toolbar">
      <button type="button" class="viewer-button viewer-zoom pressable" aria-pressed="false" hidden>원본 크기</button>
      <button type="button" class="viewer-button viewer-close pressable" autofocus>닫기</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { initBlogPost } from '../../scripts/blog-post';

  document.addEventListener('astro:page-load', initBlogPost);
</script>

<style>
  /* Reading progress: scaled, not resized, so it never triggers layout */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 101;
  }

  .post-header {
    max-width: var(--width-prose);
    padding-block: var(--spacing-xl) var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-xl);
  }

  .post-header .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
  }

  .post-meta {
    display: flex;
    gap: var(--spacing-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--spacing-xs);
  }

  .post-title {
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.625rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin-bottom: var(--spacing-sm);
  }

  .post-lead {
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--spacing-sm);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 14rem;
    justify-content: space-between;
    gap: var(--spacing-xl);
  }

  /* Table of contents */
  .toc-sticky {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
  }

  .toc-title {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-muted);
    margin-bottom: var(--spacing-xs);
  }

  .toc :global(.toc-link) {
    display: block;
    padding: 0.3rem 0 0.3rem 0.75rem;
    border-left: 1px solid var(--color-border);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .toc :global(.toc-link-sub) {
    padding-left: 1.5rem;
  }

  .toc :global(.toc-link:hover) {
    color: var(--color-text);
  }

  .toc :global(.toc-link.active) {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  @media (max-width: 1100px) {
    .post-layout {
      grid-template-columns: minmax(0, var(--width-prose));
    }

    .toc-sidebar {
      display: none;
    }
  }

  /* Post footer */
  .post-footer {
    max-width: var(--width-prose);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-md);
    border-top: 2px solid var(--color-accent);
  }

  .author-name {
    color: var(--color-text);
    font-weight: 600;
  }

  .author p:not(.author-name) {
    font-size: var(--text-sm);
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    font-size: var(--text-sm);
  }

  .action-button {
    font: inherit;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .action-button:hover {
    border-color: var(--color-text-secondary);
  }

  /* ---------- Prose (Notion content) ---------- */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-text);
  }

  .prose :global(> * + *) {
    margin-top: 1.25em;
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    color: var(--color-text);
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 5rem;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    margin-top: 2.5em;
  }

  .prose :global(h3) {
    font-size: var(--text-lg);
    margin-top: 2em;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.75em;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .prose :global(b),
  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }

  .prose :global(li + li),
  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--color-muted);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: 3em;
  }

  .prose :global(hr + h2),
  .prose :global(hr + h3) {
    margin-top: 0;
  }

  .prose :global(blockquote) {
    padding-left: 1.25em;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-secondary);
  }

  .prose :global(blockquote p) {
    color: inherit;
  }

  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    background: var(--color-code-bg);
    word-break: break-word;
  }

  /* Code blocks (wrapped with a toolbar by blog-post.ts) */
  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    tab-size: 2;
  }

  .prose :global(.code-block) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .prose :global(.code-block pre) {
    border: none;
    border-radius: 0;
  }

  .prose :global(.code-toolbar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.35rem 0.5rem 0.35rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .prose :global(.code-copy) {
    font: inherit;
    padding: 0.2rem 0.6rem;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .prose :global(.code-copy:hover) {
    color: var(--color-text);
    background: var(--color-accent-soft);
  }

  /* Tables: Notion exports every table, so let wide ones scroll instead of overflowing */
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.6em 0.9em;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(tr:first-child > *) {
    border-top: 1px solid var(--color-border);
  }

  .prose :global(th) {
    font-weight: 600;
    background: var(--color-surface);
  }

  /* Images */
  .prose :global(.notion-image) {
    margin-block: 2em;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Wrapper added by image-viewer.ts so images open the zoom viewer */
  .prose :global(.image-zoom-trigger) {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    cursor: zoom-in;
  }

  .prose :global(.image-zoom-trigger:focus-visible) {
    border-radius: var(--radius-md);
  }

  .prose :global(.image-zoom-trigger img) {
    transition: border-color var(--duration-fast) ease;
  }

  .prose :global(.image-zoom-trigger:hover img) {
    border-color: var(--color-text-secondary);
  }

  /* Videos: Notion uploads transcoded by scripts/notion-videos.ts */
  .prose :global(.notion-video) {
    margin-block: 2em;
  }

  /* --media-aspect is set per video by rehype-notion-images; portrait clips stop at 75% of the screen height */
  .prose :global(video) {
    display: block;
    width: min(100%, calc(75svh * var(--media-aspect, 16 / 9)));
    height: auto;
    aspect-ratio: var(--media-aspect, 16 / 9);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #000;
  }

  /* Notion column layouts */
  .prose :global(.notion-column_list) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--spacing-md);
  }

  .prose :global(.notion-column > * + *) {
    margin-top: 1em;
  }

  /* Notion callout */
  .prose :global(.notion-callout) {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .prose :global(.callout-icon) {
    flex-shrink: 0;
  }

  .prose :global(.callout-text) {
    flex: 1;
  }

  /* Notion toggle */
  .prose :global(.notion-toggle) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .prose :global(.notion-toggle summary) {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-weight: 500;
  }

  .prose :global(.toggle-content) {
    padding: 0 1rem 1rem 2rem;
  }

  /* Mermaid diagrams */
  .prose :global(.mermaid) {
    display: flex;
    justify-content: center;
    padding: 1.5rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .prose :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }

  .prose :global(.diagram-error) {
    width: 100%;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .prose :global(.diagram-error pre) {
    margin-top: 0.75em;
  }

  /* ---------- Image zoom viewer (driven by image-viewer.ts) ---------- */
  :global(html:has(#image-viewer[open])) {
    overflow: hidden;
  }

  /* Always dark, like a lightroom, regardless of the site theme */
  .image-viewer {
    --viewer-scrim: rgb(8 10 14 / 0.9);
    --viewer-control-bg: rgb(22 26 37 / 0.78);
    --viewer-control-bg-hover: rgb(44 50 66 / 0.9);
    --viewer-control-border: rgb(255 255 255 / 0.16);
    --viewer-control-text: #f1f3f6;

    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .image-viewer::backdrop {
    background: var(--viewer-scrim);
  }

  /* Extra top padding keeps the toolbar from covering the image */
  .viewer-stage {
    position: absolute;
    inset: 0;
    display: flex;
    padding: calc(var(--gutter) + 3rem) var(--gutter) var(--gutter);
    overflow: auto;
    overscroll-behavior: contain;
  }

  /* margin: auto centres the image without clipping it once it overflows */
  .viewer-image {
    flex-shrink: 0;
    margin: auto;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    user-select: none;
    -webkit-user-drag: none;
  }

  .is-zoomable .viewer-image {
    cursor: zoom-in;
  }

  .is-actual .viewer-image {
    max-width: none;
    max-height: none;
    border-radius: 0;
    cursor: grab;
  }

  .is-dragging .viewer-image {
    cursor: grabbing;
  }

  .viewer-toolbar {
    position: absolute;
    top: var(--gutter);
    right: var(--gutter);
    display: flex;
    gap: var(--spacing-xs);
  }

  .viewer-button {
    font: inherit;
    font-size: var(--text-sm);
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--viewer-control-border);
    border-radius: var(--radius-md);
    background: var(--viewer-control-bg);
    color: var(--viewer-control-text);
    backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .viewer-button:hover {
    background: var(--viewer-control-bg-hover);
  }

  .viewer-button[hidden] {
    display: none;
  }

  .image-viewer[open],
  .image-viewer[open]::backdrop {
    animation: image-viewer-fade var(--duration-base) var(--ease-out);
  }

  .image-viewer[open] .viewer-image {
    animation: image-viewer-rise var(--duration-base) var(--ease-out);
  }

  @keyframes image-viewer-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes image-viewer-rise {
    from {
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-viewer[open],
    .image-viewer[open]::backdrop,
    .image-viewer[open] .viewer-image {
      animation: none;
    }
  }
</style>
