---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { marked } from 'marked';

// 한국어 업무 경력 데이터만 가져오기 (work 타입만)
const experiences = await Promise.all(
  (await getCollection('experience'))
    .filter((exp: CollectionEntry<'experience'>) =>
      exp.data.lang === 'ko' && exp.data.type === 'work'
    )
    .sort((a: CollectionEntry<'experience'>, b: CollectionEntry<'experience'>) => a.data.order - b.data.order)
    .map(async (exp: CollectionEntry<'experience'>) => ({
      id: exp.id,
      data: exp.data,
      htmlContent: await marked.parse(exp.body ?? ''),
    }))
);

const areas = [
  {
    title: '프론트엔드',
    description: '사용자 인터페이스와 경험을 최우선으로 생각합니다. 성능이 좋고 접근성을 갖춘 화면을 만듭니다.',
    stack: ['React', 'Vue', 'TypeScript', 'Astro', 'Tailwind CSS'],
  },
  {
    title: '백엔드',
    description: '확장 가능하고 안전한 서버 구조를 설계합니다. REST와 GraphQL API로 데이터를 다룹니다.',
    stack: ['Node.js', 'Python', 'PostgreSQL', 'MongoDB', 'GraphQL'],
  },
  {
    title: '클라우드와 배포',
    description: 'AWS 위에 인프라를 구성하고 CI/CD로 배포를 자동화합니다.',
    stack: ['AWS', 'Docker', 'GitHub Actions', 'Vercel', 'Git'],
  },
];
---

<BaseLayout title="About - 민동익 (Douglas)" description="민동익(Douglas)의 소개, 경력, 연락처">
  <div class="container">
    <header class="page-intro">
      <h1>민동익 <span class="roman">Dongik Min</span></h1>
      <p class="lead">
        사용자 중심의 경험을 만드는 풀스택 개발자입니다. 아이디어를 빠르게 MVP로 만들어 시장 반응을 확인하고,
        요즘은 AWS 위에서 AI 에이전트를 만드는 일에 집중하고 있습니다.
      </p>
    </header>

    <div class="about-sections">
      <section aria-labelledby="areas">
        <header class="section-head">
          <h2 id="areas">하는 일</h2>
        </header>
        <div class="areas">
          {areas.map((area) => (
            <div class="area">
              <h3>{area.title}</h3>
              <p>{area.description}</p>
              <ul class="tag-list">
                {area.stack.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="career">
        <header class="section-head">
          <h2 id="career">경력</h2>
          <a class="text-link" href="/experience">프로젝트와 연구 경력까지 보기</a>
        </header>
        <ExperienceList items={experiences} />
      </section>

      <section id="contact" aria-labelledby="contact-title">
        <header class="section-head">
          <h2 id="contact-title">연락</h2>
        </header>
        <div class="contact">
          <p>새 프로젝트나 협업 제안은 이메일로 보내주세요.</p>
          <div class="contact-actions">
            <a class="primary-button pressable" href="mailto:dongik20@naver.com">dongik20@naver.com</a>
            <a class="text-link" href="https://github.com/DouglasMin" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .roman {
    color: var(--color-muted);
    font-weight: 400;
    margin-left: var(--spacing-xs);
  }

  .lead {
    font-size: var(--text-lg);
    line-height: 1.6;
    max-width: 38rem;
  }

  .about-sections {
    display: grid;
    gap: var(--spacing-2xl);
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .area h3 {
    margin-bottom: var(--spacing-xs);
  }

  .area p {
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-sm);
  }

  .contact p {
    max-width: 34rem;
    margin-bottom: var(--spacing-md);
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .primary-button {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 500;
  }

  .primary-button:hover {
    color: var(--color-on-accent);
    background: var(--color-accent-hover);
  }

  @media (max-width: 760px) {
    .areas {
      grid-template-columns: 1fr;
    }
  }
</style>
