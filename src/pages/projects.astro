---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Rows show the year in the gutter, so they read newest first
const allProjects = (await getCollection('projects'))
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const groups = [
  { id: 'portfolio', title: '포트폴리오', description: '직접 기획하고 만든 제품과 도구' },
  { id: 'personal', title: '연구', description: '연구실과 산학 과제에서 진행한 프로젝트' },
  { id: 'client', title: '외주', description: '클라이언트 의뢰로 만든 작업' },
] as const;

const sections = groups
  .map((group) => ({
    ...group,
    projects: allProjects.filter((project: CollectionEntry<'projects'>) => project.data.category === group.id),
  }))
  .filter((group) => group.projects.length > 0);
---

<BaseLayout title="프로젝트 - 민동익 (Douglas)" description="민동익(Douglas)이 만든 제품, 연구, 외주 프로젝트">
  <div class="container">
    <header class="page-intro">
      <h1>프로젝트</h1>
      <p>AI 에이전트, 서버리스 백엔드, 모바일 앱까지 직접 만들고 배포한 작업들입니다.</p>
    </header>

    <div class="groups">
      {sections.map((group) => (
        <section aria-labelledby={`group-${group.id}`}>
          <header class="section-head">
            <h2 id={`group-${group.id}`}>
              {group.title}<span class="count">{group.projects.length}</span>
            </h2>
            <p class="group-description">{group.description}</p>
          </header>
          <ProjectList projects={group.projects} />
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: var(--spacing-2xl);
  }

  .group-description {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 640px) {
    .group-description {
      display: none;
    }
  }
</style>
