---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList, { type ExperienceItem } from '../components/ExperienceList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { marked } from 'marked';

type Lang = 'ko' | 'en';
type ExperienceType = CollectionEntry<'experience'>['data']['type'];

const copy = {
  ko: {
    title: '경력',
    intro: '회사, 산학 프로젝트, 연구실에서 해온 일을 시간순으로 정리했습니다.',
    sections: { work: '업무', project: '프로젝트', research: '연구' },
  },
  en: {
    title: 'Experience',
    intro: 'Work, industry projects, and research, in reverse chronological order.',
    sections: { work: 'Work', project: 'Projects', research: 'Research' },
  },
} as const;

const TYPES: ExperienceType[] = ['work', 'project', 'research'];

const allExperiences = (await getCollection('experience'))
  .sort((a: CollectionEntry<'experience'>, b: CollectionEntry<'experience'>) => a.data.order - b.data.order);

async function buildSections(lang: Lang) {
  const items: ExperienceItem[] = await Promise.all(
    allExperiences
      .filter((exp: CollectionEntry<'experience'>) => exp.data.lang === lang)
      .map(async (exp: CollectionEntry<'experience'>) => ({
        id: exp.id,
        data: exp.data,
        htmlContent: await marked.parse(exp.body ?? ''),
      })),
  );
  return TYPES
    .map((type) => ({ type, title: copy[lang].sections[type], items: items.filter((item) => item.data.type === type) }))
    .filter((section) => section.items.length > 0);
}

const languages = await Promise.all(
  (['ko', 'en'] as const).map(async (lang) => ({ lang, sections: await buildSections(lang) })),
);
---

<BaseLayout title="경력 - 민동익 (Douglas)" description="민동익(Douglas)의 업무, 프로젝트, 연구 경력">
  <div class="container">
    {languages.map(({ lang, sections }) => (
      <div class="lang-block" data-lang={lang} lang={lang} hidden={lang !== 'ko'}>
        <header class="page-intro">
          <nav class="lang-switch" aria-label="언어 선택 / Language">
            <a href="/experience?lang=ko" lang="ko" aria-current={lang === 'ko' ? 'true' : undefined}>한국어</a>
            <a href="/experience?lang=en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
          </nav>
          <h1>{copy[lang].title}</h1>
          <p>{copy[lang].intro}</p>
        </header>

        <div class="sections">
          {sections.map((section) => (
            <section aria-labelledby={`${lang}-${section.type}`}>
              <header class="section-head">
                <h2 id={`${lang}-${section.type}`}>{section.title}<span class="count">{section.items.length}</span></h2>
              </header>
              <ExperienceList items={section.items} />
            </section>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .lang-switch {
    display: flex;
    gap: var(--spacing-sm);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-lg);
  }

  .lang-switch a {
    color: var(--color-muted);
  }

  .lang-switch a:hover {
    color: var(--color-text);
  }

  .lang-switch a[aria-current] {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .sections {
    display: grid;
    gap: var(--spacing-2xl);
  }
</style>

<script>
  // The site is static, so the ?lang= choice is applied in the browser.
  function applyLanguage() {
    const blocks = document.querySelectorAll<HTMLElement>('.lang-block');
    if (blocks.length === 0) return;
    const lang = new URLSearchParams(window.location.search).get('lang') === 'en' ? 'en' : 'ko';
    blocks.forEach((block) => {
      block.hidden = block.dataset.lang !== lang;
    });
  }

  document.addEventListener('astro:page-load', applyLanguage);
</script>
