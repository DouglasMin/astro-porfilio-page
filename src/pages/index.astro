---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { toSortedPosts } from '../lib/blog';

const RECENT_POST_COUNT = 4;
const FEATURED_PROJECT_COUNT = 4;

// Rows show the year in the gutter, so they read newest first
const byNewest = (a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime();

const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter((project: CollectionEntry<'projects'>) => project.data.featured && project.data.category !== 'client')
  .sort(byNewest)
  .slice(0, FEATURED_PROJECT_COUNT);

const clientProjects = allProjects
  .filter((project: CollectionEntry<'projects'>) => project.data.category === 'client')
  .sort(byNewest);

const recentPosts = toSortedPosts(await getCollection('blog')).slice(0, RECENT_POST_COUNT);
---

<BaseLayout title="민동익 (Douglas) - 개발자 포트폴리오" description="AI 에이전트와 서버리스로 아이디어를 빠르게 제품으로 만드는 풀스택 개발자/DevOps 민동익(Douglas)의 포트폴리오와 기술 블로그">
  <section class="hero container" aria-labelledby="hero-name">
    <h1 id="hero-name" class="hero-name">민동익</h1>
    <div class="hero-aside">
      <p class="hero-roman" style="--i: 1">Dongik Min (Douglas)</p>
      <p class="hero-statement" style="--i: 2">
        AI 에이전트와 서버리스로 아이디어를 빠르게 제품으로 만드는 풀스택 개발자/DevOps입니다.
        만든 것은 여기에, 배운 것은 블로그에 기록합니다.
      </p>
      <ul class="hero-links" style="--i: 3">
        <li><a class="text-link" href="https://github.com/DouglasMin" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a class="text-link" href="mailto:dongik20@naver.com">이메일</a></li>
        <li><a class="text-link" href="/about">경력</a></li>
      </ul>
    </div>
  </section>

  <div class="container home-sections">
    {recentPosts.length > 0 && (
      <section aria-labelledby="recent-posts">
        <header class="section-head">
          <h2 id="recent-posts">최근 글</h2>
          <a class="text-link" href="/blog">모든 글</a>
        </header>
        <PostList posts={recentPosts} />
      </section>
    )}

    {featuredProjects.length > 0 && (
      <section aria-labelledby="featured-projects">
        <header class="section-head">
          <h2 id="featured-projects">프로젝트</h2>
          <a class="text-link" href="/projects">모든 프로젝트</a>
        </header>
        <ProjectList projects={featuredProjects} />
      </section>
    )}

    {clientProjects.length > 0 && (
      <section aria-labelledby="client-projects">
        <header class="section-head">
          <h2 id="client-projects">외주</h2>
        </header>
        <ProjectList projects={clientProjects} />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 24rem);
    align-items: end;
    gap: var(--spacing-md) var(--spacing-xl);
    padding-block: clamp(4rem, 12vw, 9rem) clamp(3rem, 8vw, 6rem);
  }

  .hero-name {
    font-size: clamp(4.5rem, 16vw, 10rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--color-accent);
    /* Optical nudge: Hangul sidebearings make the name look indented at this size */
    margin-left: -0.04em;
  }

  .hero-roman {
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: var(--spacing-xs);
  }

  .hero-statement {
    margin-bottom: var(--spacing-sm);
  }

  .hero-links {
    display: flex;
    gap: var(--spacing-md);
    list-style: none;
    font-size: var(--text-sm);
  }

  /*
   * The page's one orchestrated moment: the name is revealed upward,
   * then the aside follows in a short stagger. Plays once per page load.
   */
  .hero-name {
    animation: name-reveal 700ms var(--ease-out) both;
  }

  .hero-aside > * {
    animation: rise 500ms var(--ease-out) both;
    animation-delay: calc(200ms + var(--i) * 60ms);
  }

  @keyframes name-reveal {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(0.2em);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name,
    .hero-aside > * {
      animation-name: fade;
      animation-duration: 300ms;
    }
  }

  .home-sections {
    display: grid;
    gap: var(--spacing-2xl);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
